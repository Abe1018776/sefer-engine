\sefer-header[pagenum=ח,bookname=שפע,section=שער גמילות חסדים,author=שלמה]
\maintext{מעלה את הקב״ה, הוא על הטובות שמשפיע לבני ישראל, כי כשרואים בטובת ישראל מספרים גודל שבחו, לפי שבזה ניכר תוקף חסדו וכח גבורתו.}
\sectionheader{מהות ה׳חסיד׳ - מתפלל ומיטיב לזולתו}
\sectionbody{ו. לעומת זאת, המרחם על חברו, משתתף בצערו ומתפלל בעדו, הרי הוא נחשב חלקו ונחלתו של הקב״ה״א. ולא ייקרא האדם בתואר ׳חסיד׳, שנקרא כן על שם החסד שגומל, אלא אם כן הוא דורש טובת זולתו ומבקש עליו רחמים; שכן מי שמבקש, מתפלל ומשפיע רק על עצמו, אין מעשיו נחשבים לחסד כלל: \marker{ג}.}
\sefer-divider
\typeset-into[frame=makor_col]{\col-title{מקור השפע}\sourcetext{׳ישמח ה׳ במעשיו׳ (תהלים קד לא), ונגד כבודו יתברך שמו לא היה שוה בעיניו כלל צער של בני ישראל. כך רצון ה׳ יתברך אינו בזה, כי חפצו ורצונו שיהיה מנהיג הדור כדי לעורר רחמים על בני ישראל ולא לחוס על כבוד הבורא לבד. וזה הענין שמצינו ברבי ישמעאל בן אלישע (ברכות ז א) שנכנס לפני ולפנים והיה מתפלל על בני ישראל יה״ר שיכבשו רחמיך את ענשך ויגולו רחמיך כו׳, לכאורה למה לא התפלל על כבוד הבורא ׳ובכן תן פחדך׳ וכדומה, אך באמת זה דרכו יתברך שמו לראות בטובה בני ישראל. וזה היה ג״כ חסרון של נדב ואביהוא ׳בקרבתם לפני ה׳׳, פירוש שהיו הולכים תמיד רק במדריגה זו לפני ה׳ - לחוס רק על כבודו לבד, למסור נפש עבורי ית״ש, לכך זימותו׳, כי זה הדרך הוא עצמו, אבל לטובת הדור ולהנחיגם צריך הצדיק להיות בעל הרחמים לבקש טובתם ולעורר רחמים חסדים, ומאשר לא היה להם הנהגה בעוה״ז לכן נסתלקו מעוה״ז. \par בפרשת פנחס (ד״ה החתן): ״יש שני מיני צדיקים, האחד, הוא המייחל ומצפה על גדולת הבורא ב״ה יהי כבוד ה׳ לעולם בביאת משיח במהרה בימינו... אולם יש בחינה אחרת בצדיק יסוד עולם, להיות דורש טוב לעמו, אשר בזה בחר ה׳, כי חפצו ורצונו יתברך שמו להיות צדיק כזה להשפיע טוב לבני ישראל, כאשר היה חיכך כוונת הברכה בזה, כמו שאומרים (ברכת ההפטרה) ׳צור כל העולמות צדיק בכל הדורות׳ - דור דור ודורשיו, שיהיה המנהיג סובל הדור ומרחם עליהם ולהמתיק הדינים מהם... [כי] זהו כבוד הבורא להיטיב לבראיו עם בני ישראל״. \par כ. פרשת פנחס (ד״ה החתן): ״וזה פירוש ׳יאל ברוך נעימות יתנו למלך אל חי וקיים וכו׳ כי הוא לבדו מרום וקדוש׳ (ברכת יוצר אור). פירוש גם המלאכים שלמעלה אינם יכולין לספר בשבחו, ׳כי הוא לבדו מרום וקדוש׳ ומי יוכל להשיג ולממותו יתברך שמו. אך זאת יתנו גודל שבחו כאשר רואים בטובת בני ישראל, בזה יכירו כח גבורתו יתברך שמו כמו שנאמר להלן (שם) ׳פועל גבורות עושה חדשות בורא רפואות׳ וכו׳״. \par כא. מבוא השער (אחר הנחת תפילין): ״׳קדש לי כל בכור פטר כל רחם בני ישראל׳ (שמות יג, ב)... ׳פטר כל רחם׳ פירוש פתיחת כל הרחמנות של האדם יהיה ׳בבני ישראל׳, כל מי שיש בו רחמנות על חברו בבנ״י להצטער עמו להיות בעזרתו בכל מה שיוכל, גם להתפלל עבורו אל ה׳ וכו׳ זה ׳לי הוא׳, איש כזה הוא לי לשמי״. \par כב. פרשת ויצא (ד״ה ויצא ה׳): ״להורות דרך הישר לפני האדם ההולך בדרכי החסידות, כשמעורר בתפלה לא ישים מגמתו על מה שנוגע לעצמו וחסר לו, רק יהמן המון רחמיו על זולתו להשפיע עליו חסדים וטובות... ולזה}}
\typeset-into[frame=tzinor_col]{\col-title{צינור השפע}\sourcetext{\marker{ג} מסופר על רבינו הרה״ק בעל התפארת שלמה מראדומסק זיע״א שבשבת פרשת נח היה מסתגר בחדרו ולא היה יוצא לערוך שלחנו הטהור, באמרו על נח ׳ער איז געווענזען א צדיק אין פעלץ, ער האט זיך פארשלאסען אין קאסטען׳ (הוא היה צדיק בתוך אדרו, שגר עצמו בתוך תיבה), כלומר שסגר עצמו בתיבה והפקיד את בני דורו להשחתם במי המבול. ומבואר שם בהמשך על להשחתם במי המבול.}}

\end{document}