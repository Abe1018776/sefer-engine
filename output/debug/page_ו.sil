\sefer-header[pagenum=ו,bookname=שפע,section=שער גמילות חסדים,author=שלמה]
\maintext{וכללות ישראל״, וכמו שמצינו צדיקים גדולים וטובים אשר מעולם המה, שלא כוונו כל ימיהם רק על רוממות כבודו יתברך שמו, ולא שמו אל לבם לעורר רחמים ולהמשיך טובות עולם הזה לבני דורם - לא האריכו ימים ולא זכו להנהגה בעולם הזה; כי הנהגה כזו לא הוטבה בעיני ה׳\marker{א}, לפי שרוצה ה׳ בעמו וחפץ להיטיב להם״. לפיכך, כל חפצו ורצונו יתברך שמו שיהיה האדם מעורר רחמים על בני ישראל ומשפיע עליהם כל טוב, ולא יחוס רק על כבוד הבורא ב״ה, כי זה כבודו יתברך שמו לראות בטובת ישראל״, שכן על ידי טובתם מתגדל ומתקדש שמו יתברך בעולם \marker{ב}. ולא עוד, אלא שכל השבח הגדול שמשבחים ומפארים מלאכי יתברך בעולם}
\sefer-divider
\typeset-into[frame=makor_col]{\col-title{מקור השפע}\sourcetext{יז. יוה״כ (ד״ה תניא): ״ידוע מחטא של נדב ואביהוא ׳בקרבתם לפני ה׳ וימותו׳ (ויקרא טז א), פירוש הדבר, שהיו נכנסים בבחינה היותר גבוהה, שהיתה כל מגמתם עבור כבודו יתברך שמו ולא היו משגיחים כלל לטובת כלל ישראל. וזהו ׳בקרבתם לפני ה׳ וכו׳. ולזה נדב ואביהוא שנכנסו בבחינה היותר גבוהה ולא השגיחו לטובת כלל ישראל ולא היו בבחינת מין האנושי, לכן ׳וימותו׳, שלא היה להם עוד חיות בעולם הזה״. \par יח. פרשת וישב (ד״ה א״י לו): ״מצינו צדיקים גדולים וטובים אשר מעולם המה שלא כוונו כל ימיהם רק על רוממות כבודו ית״ש ולא שתו את לבם לטובת עוה״ז להשפיע לדורם וכו׳, וכן היה ענין נדב ואביהוא כתיב (ויקרא טז א) ׳בקרבתם לפני ה׳ וימותו׳. ומפני כי כל עבודתם היה רק על כבודו ית״ש כנ״ל לכן לא היה להם הנהגה בזה העולם. וכן היה ענין ער ואונן שהיו נשמות גבוהים מאד כנודע, וחטאו בזה שלא חשבו בטובת אחיהם בעוה״ז, כמו שנאמר (בראשית לח ט) ׳לבלתי נתן זרע לאחיו׳, ׳זרע׳ הוא בחינת ה׳אור זרוע לצדיק׳ (תהלים צז יא) להצמיח בקרב ישראל יראת שמים והשפעות טובות, לכן לא הוטב בעיני ה׳, כי רוצה ה׳ בעמו ומרובה להטיב להם ובטובם נתגדל ונתקדש שמו יתברך בעולם״.}}
\typeset-into[frame=tzinor_col]{\col-title{צינור השפע}\sourcetext{\marker{א} בנפלאות התפארת שלמה (ח״א אות סב) הובא: ״מרגלא בפומיה דאא״ז [רבינו התפארת שלמה זי״ע] לומר, כי יש צדיקים הרבה אשר עבודתם לה׳ בדחילו ורחימו כמלאכי מעלה, ומכל מקום לאחר מאה שנה יבושו מעבודתם, באשר לא עשו העיקר להעורר רחמים עבור בני ישראל ולעורר רחמים עליהם בישועה רוחנית וגשמית ולמסור נפשם עבור כלל ישראל, כמו משה רבינו שאמר ׳ואם מחני נא׳״. \par וכעין זה מצינו בהנהגת הרה״ק הרבי ר׳ אלימלך מליזענסק זי״ע, שכפי שהעיד בנו בהקדמת ספרו: ״אשר תמיד על פה כבוד אבי מורי הורגלו להיות מברך את ישראל, ולמסור נפשו עליהם בכל עת, לבטל מהם גזירות רעות בתפילתו הנאמנה במסירות נפש״. \par ומשום כך תבע רבינו התפארת שלמה מהצדיקים לדאוג לצרכיהם הגשמיים של הדור, וכפי שאמר פעם להג״ק רבי שמעון סופר מקראקא זי״ע: ״כל צדיק שאינו ממשיך שפע ברכה פרנסה ועשירות לישראל אינו בכלל צדיק״. ופירש בזה הגמרא (קידושין מ א): ״וכי יש צדיק טוב ויש צדיק שאינו טוב, אלא טוב לשמים ולבריות זהו צדיק שאינו טוב, טוב לשמים ורע לבריות זהו צדיק טוב״, והיא פלייה גדולה, אם הוא רע לבריות איך שייך לומר שהוא צדיק... אלא הכונה היא לצדיק גמור, אלא שאינו ממשיך השפעות טובות לבריות, לפיכך נקרא ׳צדיק רע׳ לפי שאינו מיטיב לאחרים (נפלאות התפארת שלמה אות קלב). \par פעם דיבר רבינו בקדשו ואמר כי עיקר חורבן בית המקדש היה מפני ש״לא השפיעו הצדיקים עבור בני דורם״, וזה שדרשו חז״ל (נדרים פא א) ״על מה אבדה הארץ - על עזבם את תורתי - שלא ברכו בתורה תחילה״, ״כי עיקר ענין ברכת התורה הוא להשפיע ברכות וישועות לעולם על ידי התורה... והם לא עסקו בתורה על דעת זה להמשיך שפע לעולם, וכיון שלא היה לימודם בבחינה זו, ממילא נחרבה הארץ״ (ראה תפארת שלמה מאמרי שבועות ד״ה כה תאמר).}}

\end{document}